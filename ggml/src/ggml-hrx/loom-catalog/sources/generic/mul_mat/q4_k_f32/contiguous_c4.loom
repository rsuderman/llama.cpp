config.decl @shape_mul_mat_q4_k_f32_contiguous_c4_k : %value: index where [range(%value, 256, 32768), mul(%value, 256)]
config.decl @shape_mul_mat_q4_k_f32_contiguous_c4_rows : %value: index where [range(%value, 1, 32768)]
config.decl @shape_mul_mat_q4_k_f32_contiguous_c4_cols : %value: index where [range(%value, 4, 1024), mul(%value, 4)]
config.decl @tuning_mul_mat_q4_k_f32_contiguous_c4_workgroup_size : %value: index where [range(%value, 64, 256), mul(%value, 64)]

kernel.def export("hrx2_mul_mat_q4_k_f32_contiguous_c4") @hrx2_mul_mat_q4_k_f32_contiguous_c4() {
  %unit = index.constant 1 : index
  %four = index.constant 4 : index
  %rows = config.get @shape_mul_mat_q4_k_f32_contiguous_c4_rows : index
  %cols = config.get @shape_mul_mat_q4_k_f32_contiguous_c4_cols : index
  %workgroup_size = config.get @tuning_mul_mat_q4_k_f32_contiguous_c4_workgroup_size : index
  %col_groups = index.div %cols, %four : index
  kernel.launch.config workgroups(%rows, %col_groups, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero_index = index.constant 0 : index
  %zero_i32 = scalar.constant 0 : i32
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirtytwo = index.constant 32 : index
  %sixtyfour = index.constant 64 : index
  %six_i32 = scalar.constant 6 : i32
  %four_i32 = scalar.constant 4 : i32
  %mask_0f = scalar.constant 15 : i32
  %mask_3f = scalar.constant 63 : i32
  %qk = index.constant 256 : index
  %block_bytes = index.constant 144 : index
  %block_f16s = index.constant 72 : index
  %scale_offset = index.constant 4 : index
  %qs_offset = index.constant 16 : index
  %k = config.get @shape_mul_mat_q4_k_f32_contiguous_c4_k : index
  %rows = config.get @shape_mul_mat_q4_k_f32_contiguous_c4_rows : index
  %cols = config.get @shape_mul_mat_q4_k_f32_contiguous_c4_cols : index
  %workgroup_size = config.get @tuning_mul_mat_q4_k_f32_contiguous_c4_workgroup_size : index
  %k_bounded = index.assume %k [range(%k, 256, 32768)] : index
  %rows_bounded = index.assume %rows [range(%rows, 1, 32768)] : index
  %cols_bounded = index.assume %cols [range(%cols, 4, 1024)] : index
  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 32767)] : index
  %col_group = kernel.workgroup.id<y> : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %zero_f32 = scalar.constant 0.0 : f32

  %col0 = index.mul %col_group, %four : index
  %col1 = index.add %col0, %one : index
  %col2 = index.add %col0, %two : index
  %col3 = index.add %col0, %three : index

  %blocks_per_row = index.div %k_bounded, %qk : index
  %total_blocks = index.mul %rows_bounded, %blocks_per_row : index
  %src0_i8_count = index.mul %total_blocks, %block_bytes : index
  %src0_f16_count = index.mul %total_blocks, %block_f16s : index
  %src1_count = index.mul %cols_bounded, %k_bounded : index
  %dst_count = index.mul %cols_bounded, %rows_bounded : index

  %block_lane = index.rem %lane, %sixtyfour : index
  %block_slot = index.div %lane, %sixtyfour : index
  %block_step = index.div %workgroup_size, %sixtyfour : index
  %group = index.div %block_lane, %eight : index
  %lane_in_group = index.rem %block_lane, %eight : index
  %lane_q = index.mul %lane_in_group, %four : index
  %group_half = index.div %group, %two : index
  %qs_group_base = index.mul %group_half, %thirtytwo : index
  %qs_lane_base = index.add %qs_group_base, %lane_q : index
  %group_parity = index.rem %group, %two : index
  %is_high_group = index.cmp eq, %group_parity, %one : index

  %src0_global = buffer.assume.memory_space<descriptor> %src0 : buffer
  %src1_global = buffer.assume.memory_space<descriptor> %src1 : buffer
  %dst_global = buffer.assume.memory_space<descriptor> %dst : buffer
  %src0_noalias, %src1_noalias, %dst_noalias = buffer.assume.noalias %src0_global, %src1_global, %dst_global : buffer, buffer, buffer
  %src0_i8_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_i8_count]xi8, #dense>
  %src0_f16_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_f16_count]xf16, #dense>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32, #dense>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32, #dense>

  %row_block_base = index.mul %row, %blocks_per_row : index
  %src1_col_base0 = index.mul %col0, %k_bounded : index
  %src1_col_base1 = index.mul %col1, %k_bounded : index
  %src1_col_base2 = index.mul %col2, %k_bounded : index
  %src1_col_base3 = index.mul %col3, %k_bounded : index
  %sum0, %sum1, %sum2, %sum3 = scf.for %block_idx = [%block_slot to %blocks_per_row step %block_step](%acc0 = %zero_f32 : f32, %acc1 = %zero_f32 : f32, %acc2 = %zero_f32 : f32, %acc3 = %zero_f32 : f32) -> (f32, f32, f32, f32) {
    %src_base_block = index.mul %block_idx, %qk : index
    %src_base_group = index.mul %group, %thirtytwo : index
    %src_base0 = index.add %src_base_block, %src_base_group : index
    %src_base = index.add %src_base0, %lane_q : index
    %linear_block = index.add %row_block_base, %block_idx : index
    %block_byte_base = index.mul %linear_block, %block_bytes : index
    %block_f16_base = index.mul %linear_block, %block_f16s : index
    %dmin_index = index.add %block_f16_base, %one : index
    %scale_base = index.add %block_byte_base, %scale_offset : index
    %qs_payload = index.add %block_byte_base, %qs_offset : index
    %qs_base = index.add %qs_payload, %qs_lane_base : index
    %d_f16 = view.load %src0_f16_view[%block_f16_base] : view<[%src0_f16_count]xf16, #dense> -> f16
    %dmin_f16 = view.load %src0_f16_view[%dmin_index] : view<[%src0_f16_count]xf16, #dense> -> f16
    %d0 = scalar.extf %d_f16 : f16 to f32
    %dmin0 = scalar.extf %dmin_f16 : f16 to f32
    %group_lt4 = index.cmp slt, %group, %four : index
    %scale_i32, %min_i32 = scf.if %group_lt4 -> (i32, i32) {
      %d_index = index.add %scale_base, %group : index
      %m_group = index.add %group, %four : index
      %m_index = index.add %scale_base, %m_group : index
      %d_i8 = view.load %src0_i8_view[%d_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %m_i8 = view.load %src0_i8_view[%m_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %d_u32 = scalar.extui %d_i8 : i8 to i32
      %m_u32 = scalar.extui %m_i8 : i8 to i32
      %d = scalar.andi %d_u32, %mask_3f : i32
      %m = scalar.andi %m_u32, %mask_3f : i32
      scf.yield %d, %m : i32, i32
    } else {
      %group_minus4 = index.sub %group, %four : index
      %group_plus4 = index.add %group, %four : index
      %low_index = index.add %scale_base, %group_minus4 : index
      %mid_index = index.add %scale_base, %group : index
      %high_index = index.add %scale_base, %group_plus4 : index
      %low_i8 = view.load %src0_i8_view[%low_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %mid_i8 = view.load %src0_i8_view[%mid_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %high_i8 = view.load %src0_i8_view[%high_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %low = scalar.extui %low_i8 : i8 to i32
      %mid = scalar.extui %mid_i8 : i8 to i32
      %high = scalar.extui %high_i8 : i8 to i32
      %scale_low = scalar.andi %high, %mask_0f : i32
      %scale_hi0 = scalar.shrui %low, %six_i32 : i32
      %scale_hi = scalar.shli %scale_hi0, %four_i32 : i32
      %d = scalar.ori %scale_low, %scale_hi : i32
      %min_low = scalar.shrui %high, %four_i32 : i32
      %min_hi0 = scalar.shrui %mid, %six_i32 : i32
      %min_hi = scalar.shli %min_hi0, %four_i32 : i32
      %m = scalar.ori %min_low, %min_hi : i32
      scf.yield %d, %m : i32, i32
    }
    %scale_f32 = scalar.uitofp %scale_i32 : i32 to f32
    %min_f32 = scalar.uitofp %min_i32 : i32 to f32
    %d = scalar.mulf<reassoc|nnan|ninf|nsz> %d0, %scale_f32 : f32
    %min = scalar.mulf<reassoc|nnan|ninf|nsz> %dmin0, %min_f32 : f32
    %next0, %next1, %next2, %next3 = scf.for %j = [%zero_index to %four step %one](%inner0 = %acc0 : f32, %inner1 = %acc1 : f32, %inner2 = %acc2 : f32, %inner3 = %acc3 : f32) -> (f32, f32, f32, f32) {
      %q_index = index.add %qs_base, %j : index
      %src_offset = index.add %src_base, %j : index
      %q_i8 = view.load %src0_i8_view[%q_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %q_byte = scalar.extui %q_i8 : i8 to i32
      %q_i32 = scf.if %is_high_group -> (i32) {
        %hi = scalar.shrui %q_byte, %four_i32 : i32
        scf.yield %hi : i32
      } else {
        %lo = scalar.andi %q_byte, %mask_0f : i32
        scf.yield %lo : i32
      }
      %q_f32 = scalar.uitofp %q_i32 : i32 to f32
      %scaled = scalar.mulf<reassoc|nnan|ninf|nsz> %d, %q_f32 : f32
      %dequant = scalar.subf<reassoc|nnan|ninf|nsz> %scaled, %min : f32

      %src1_index0 = index.add %src1_col_base0, %src_offset : index
      %rhs0 = view.load %src1_view[%src1_index0] : view<[%src1_count]xf32, #dense> -> f32
      %product0 = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs0 : f32
      %acc_next0 = scalar.addf<reassoc|nnan|ninf|nsz> %inner0, %product0 : f32

      %src1_index1 = index.add %src1_col_base1, %src_offset : index
      %rhs1 = view.load %src1_view[%src1_index1] : view<[%src1_count]xf32, #dense> -> f32
      %product1 = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs1 : f32
      %acc_next1 = scalar.addf<reassoc|nnan|ninf|nsz> %inner1, %product1 : f32

      %src1_index2 = index.add %src1_col_base2, %src_offset : index
      %rhs2 = view.load %src1_view[%src1_index2] : view<[%src1_count]xf32, #dense> -> f32
      %product2 = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs2 : f32
      %acc_next2 = scalar.addf<reassoc|nnan|ninf|nsz> %inner2, %product2 : f32

      %src1_index3 = index.add %src1_col_base3, %src_offset : index
      %rhs3 = view.load %src1_view[%src1_index3] : view<[%src1_count]xf32, #dense> -> f32
      %product3 = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs3 : f32
      %acc_next3 = scalar.addf<reassoc|nnan|ninf|nsz> %inner3, %product3 : f32

      scf.yield %acc_next0, %acc_next1, %acc_next2, %acc_next3 : f32, f32, f32, f32
    }
    scf.yield %next0, %next1, %next2, %next3 : f32, f32, f32, f32
  }

  %dot0 = kernel.workgroup.reduce<addf> %sum0 : f32
  %dot1 = kernel.workgroup.reduce<addf> %sum1 : f32
  %dot2 = kernel.workgroup.reduce<addf> %sum2 : f32
  %dot3 = kernel.workgroup.reduce<addf> %sum3 : f32
  %dst_col_base0 = index.mul %col0, %rows_bounded : index
  %dst_col_base1 = index.mul %col1, %rows_bounded : index
  %dst_col_base2 = index.mul %col2, %rows_bounded : index
  %dst_col_base3 = index.mul %col3, %rows_bounded : index
  %dst_index0 = index.add %dst_col_base0, %row : index
  %dst_index1 = index.add %dst_col_base1, %row : index
  %dst_index2 = index.add %dst_col_base2, %row : index
  %dst_index3 = index.add %dst_col_base3, %row : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    view.store %dot0, %dst_view[%dst_index0] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot1, %dst_view[%dst_index1] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot2, %dst_view[%dst_index2] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot3, %dst_view[%dst_index3] : f32, view<[%dst_count]xf32, #dense>
  }
  kernel.return
}
