// Shared Q6_K x Q8_1 row helper used by Qwen3 MoE fused projections.

func.def inline @ggml_q8_1_x4_word(%q8_input: buffer, %row_byte_base: offset, %q8_block: index, %word_in_block: index) -> (vector<4xi8>, f32) {
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %group_bytes = index.constant 144 : offset
  %payload_byte_add = index.constant 16 : offset
  %group = index.div %q8_block, %four : index
  %inner0 = index.rem %q8_block, %four : index
  %inner = index.assume %inner0 [range(%inner0, 0, 3)] : index
  %word0 = index.assume %word_in_block [range(%word_in_block, 0, 7)] : index
  %group_byte_add = index.scale %group, %group_bytes : index, offset -> offset
  %group_byte_base = index.add %row_byte_base, %group_byte_add : offset
  %payload_byte_base = index.add %group_byte_base, %payload_byte_add : offset
  %ds_view = buffer.view %q8_input[%group_byte_base] : buffer -> view<8xf16, #dense>
  %payload_view = buffer.view %q8_input[%payload_byte_base] : buffer -> view<32xi32, #dense>
  %d_index = index.mul %inner, %two : index
  %inner_word_base = index.mul %inner, %eight : index
  %word_index = index.add %inner_word_base, %word0 : index
  %d_f16 = view.load %ds_view[%d_index] : view<8xf16, #dense> -> f16
  %packed = vector.load %payload_view[%word_index] : view<32xi32, #dense> -> vector<1xi32>
  %values = vector.bitcast %packed : vector<1xi32> to vector<4xi8>
  %d = scalar.extf %d_f16 : f16 to f32
  func.return %values, %d : vector<4xi8>, f32
}

func.def inline @ggml_q6k_sign_extend_dot4(%code: vector<1xi32>) -> (vector<4xi8>) {
  %one_i32v = vector.constant 1 : vector<1xi32>
  %two_i32v = vector.constant 2 : vector<1xi32>
  %low5_mask = vector.constant 522133279 : vector<1xi32>
  %bit5_mask = vector.constant 538976288 : vector<1xi32>
  %sign_mask = vector.constant -522133280 : vector<1xi32>
  %low5 = vector.andi %code, %low5_mask : vector<1xi32>
  %bit5 = vector.andi %code, %bit5_mask : vector<1xi32>
  %bit6 = vector.shli %bit5, %one_i32v : vector<1xi32>
  %bit7 = vector.shli %bit5, %two_i32v : vector<1xi32>
  %high01 = vector.ori %bit5, %bit6 : vector<1xi32>
  %high = vector.ori %high01, %bit7 : vector<1xi32>
  %sign = vector.xori %high, %sign_mask : vector<1xi32>
  %signed_i32 = vector.ori %low5, %sign : vector<1xi32>
  %signed = vector.bitcast %signed_i32 : vector<1xi32> to vector<4xi8>
  func.return %signed : vector<4xi8>
}

func.def inline @ggml_q6k_q8_1_x4_part(%weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row_byte_base: offset, %q6_block: index, %part: index, %lane: index) -> (f32) {
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %block_bytes = index.constant 210 : offset
  %qh_byte_add = index.constant 128 : offset
  %scale_byte_add = index.constant 192 : offset
  %d_byte_add = index.constant 208 : offset
  %four_i32v = vector.constant 4 : vector<1xi32>
  %zero_i32v = vector.constant 0 : vector<1xi32>
  %nibble_mask = vector.constant 252645135 : vector<1xi32>
  %high_mask = vector.constant 808464432 : vector<1xi32>
  %bounded_part = index.assume %part [range(%part, 0, 1)] : index
  %bounded_lane = index.assume %lane [range(%lane, 0, 31)] : index
  %block_byte_add = index.scale %q6_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %weight_row_byte_base, %block_byte_add : offset
  %qh_byte_base = index.add %block_byte_base, %qh_byte_add : offset
  %scale_byte_base = index.add %block_byte_base, %scale_byte_add : offset
  %d_byte_base = index.add %block_byte_base, %d_byte_add : offset
  %ql_view = buffer.view %weight[%block_byte_base] : buffer -> view<32xi32, #dense>
  %qh_view = buffer.view %weight[%qh_byte_base] : buffer -> view<16xi32, #dense>
  %scale_view = buffer.view %weight[%scale_byte_base] : buffer -> view<16xi8, #dense>
  %d_view = buffer.view %weight[%d_byte_base] : buffer -> view<1xf16, #dense>
  %lane_mod8 = index.rem %bounded_lane, %eight : index
  %lane_mod16 = index.rem %bounded_lane, %sixteen : index
  %lane_div16 = index.div %bounded_lane, %sixteen : index
  %lane_div8_in_16 = index.div %lane_mod16, %eight : index
  %lane_div4_in_16 = index.div %lane_mod16, %four : index
  %qh_high_base = index.mul %lane_div16, %eight : index
  %qh_index0 = index.add %qh_high_base, %lane_mod8 : index
  %qh_index = index.assume %qh_index0 [range(%qh_index0, 0, 15)] : index
  %ql_word = vector.load %ql_view[%bounded_lane] : view<32xi32, #dense> -> vector<1xi32>
  %qh_word = vector.load %qh_view[%qh_index] : view<16xi32, #dense> -> vector<1xi32>
  %part_shift_index = index.mul %bounded_part, %four : index
  %part_shift_i32 = index.cast %part_shift_index : index to i32
  %part_shift = vector.splat %part_shift_i32 : vector<1xi32>
  %ql_shifted = vector.shrui %ql_word, %part_shift : vector<1xi32>
  %ql = vector.andi %ql_shifted, %nibble_mask : vector<1xi32>
  %qh_base_shift_index = index.mul %lane_div8_in_16, %two : index
  %qh_base_shift_i32 = index.cast %qh_base_shift_index : index to i32
  %qh_shift_i32 = scalar.addi %qh_base_shift_i32, %part_shift_i32 : i32
  %qh_shift = vector.splat %qh_shift_i32 : vector<1xi32>
  %qh_shifted = vector.shrui %qh_word, %qh_shift : vector<1xi32>
  %qh_positioned = vector.shli %qh_shifted, %four_i32v : vector<1xi32>
  %qh = vector.andi %qh_positioned, %high_mask : vector<1xi32>
  %code = vector.ori %ql, %qh : vector<1xi32>
  %signed_weight = func.call @ggml_q6k_sign_extend_dot4(%code) : (vector<1xi32>) -> (vector<4xi8>)
  %q8_block_base = index.mul %q6_block, %eight : index
  %q8_part_add = index.mul %bounded_part, %two : index
  %q8_high_add = index.mul %lane_div16, %four : index
  %q8_quadrant = index.add %q8_high_add, %lane_div8_in_16 : index
  %q8_block_part = index.add %q8_block_base, %q8_part_add : index
  %q8_block = index.add %q8_block_part, %q8_quadrant : index
  %q8_values, %q8_d = func.call @ggml_q8_1_x4_word(%q8_input, %q8_row_byte_base, %q8_block, %lane_mod8) : (buffer, offset, index, index) -> (vector<4xi8>, f32)
  %scale_high_base = index.mul %lane_div16, %eight : index
  %scale_lane0 = index.add %scale_high_base, %lane_div4_in_16 : index
  %scale_lane = index.add %scale_lane0, %part_shift_index : index
  %scale_i8 = view.load %scale_view[%scale_lane] : view<16xi8, #dense> -> i8
  %d_f16 = view.load %d_view[0] : view<1xf16, #dense> -> f16
  %scale = scalar.sitofp %scale_i8 : i8 to f32
  %d = scalar.extf %d_f16 : f16 to f32
  %dot = vector.dot4i<s8s8> %signed_weight, %q8_values, %zero_i32v : vector<4xi8>, vector<4xi8>, vector<1xi32>
  %dot_i32 = vector.extract %dot[0] : vector<1xi32> -> i32
  %dot_f32 = scalar.sitofp %dot_i32 : i32 to f32
  %scaled0 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot_f32, %scale : f32
  %scaled1 = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled0, %d : f32
  %contribution = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled1, %q8_d : f32
  func.return %contribution : f32
}

func.def inline @ggml_q6k_q8_1_x4_row_lane(%input_size: index, %weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row_byte_base: offset, %lane: index) -> (f32) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 32768), mul(%input_size, 256)] : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %twofiftysix = index.constant 256 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %block_count = index.div %bounded_input_size, %twofiftysix : index
  %result = scf.for %block = [%zero to %block_count step %one](%block_acc = %zero_f32 : f32) -> (f32) {
    %next = scf.for %part = [%zero to %two step %one](%part_acc = %block_acc : f32) -> (f32) unroll {
      %contribution = func.call @ggml_q6k_q8_1_x4_part(%weight, %weight_row_byte_base, %q8_input, %q8_row_byte_base, %block, %part, %lane) : (buffer, offset, buffer, offset, index, index, index) -> (f32)
      %part_next = scalar.addf<reassoc|nnan|ninf|nsz> %part_acc, %contribution : f32
      scf.yield %part_next : f32
    }
    scf.yield %next : f32
  }
  func.return %result : f32
}
