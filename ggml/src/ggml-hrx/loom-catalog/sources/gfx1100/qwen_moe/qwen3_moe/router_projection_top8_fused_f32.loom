amdgpu.target<gfx1100> @qwen3_moe_router_fused_gfx11_wave32 {subgroup_size = 32}

kernel.def @qwen3_moe_router_zero_i32() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%dst: buffer) {
  %zero = index.constant 0 : index
  %zero_i32 = scalar.constant 0 : i32
  %zero_offset = index.constant 0 : offset
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %dst_aligned = buffer.assume.alignment %dst_global {minimum_alignment = 16} : buffer
  %dst_view = buffer.view %dst_aligned[%zero_offset] : buffer -> view<1xi32, #dense>
  view.store %zero_i32, %dst_view[%zero] : i32, view<1xi32, #dense>
  kernel.return
}

kernel.def target(@qwen3_moe_router_fused_gfx11_wave32) @qwen3_moe_router_projection_top8_fused_decode_f32(%token_count: index, %route_id_stride: index) {
  %expert_count = config.get @qwen3_moe_router_expert_count : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %wave_size = index.constant 32 : index
  %expert_tiles = index.div %expert_count, %four : index
  kernel.launch.config workgroups(%expert_tiles, %one, %one) workgroup_size(%wave_size, %one, %one) : index
} launch(%token_count: index, %route_id_stride: index, %input: buffer, %weight: buffer, %logits: buffer, %completion_counter: buffer, %route_ids: buffer, %route_weights: buffer) {
  %hidden_size0 = config.get @qwen3_moe_model_hidden_size : index
  %expert_count0 = config.get @qwen3_moe_router_expert_count : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 1)] : index
  %bounded_route_id_stride = index.assume %route_id_stride [range(%route_id_stride, 1, 512)] : index
  %hidden_size, %expert_count = index.assume %hidden_size0, %expert_count0 [range(%hidden_size0, 128, 32768), mul(%hidden_size0, 256), range(%expert_count0, 64, 512), mul(%expert_count0, 64)] : index, index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %onetwentyeight = index.constant 128 : index
  %expert_tile_count0 = index.div %expert_count, %four : index
  %expert_tile_count = index.assume %expert_tile_count0 [range(%expert_tile_count0, 16, 128)] : index
  %expert_tile0 = kernel.workgroup.id<x> : index
  %expert_tile = index.assume %expert_tile0 [lt(%expert_tile0, %expert_tile_count)] : index
  %lane = kernel.subgroup.lane.id : index
  %zero_i32 = scalar.constant 0 : i32
  %one_i32 = scalar.constant 1 : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %publishes_row = scalar.constant true : i1
  %zero_offset = index.constant 0 : offset
  %token = index.assume %zero [lt(%zero, %bounded_token_count)] : index
  %expert_base = index.mul %expert_tile, %four : index
  %expert1 = index.add %expert_base, %one : index
  %expert2 = index.add %expert_base, %two : index
  %expert3 = index.add %expert_base, %three : index
  %lane_channel = index.mul %lane, %four : index
  %input_noalias, %weight_noalias, %logits_noalias, %completion_counter_noalias, %route_ids_noalias, %route_weights_noalias = buffer.assume.noalias %input, %weight, %logits, %completion_counter, %route_ids, %route_weights : buffer, buffer, buffer, buffer, buffer, buffer
  %completion_counter_global = buffer.assume.memory_space<global> %completion_counter_noalias : buffer
  %completion_counter_aligned = buffer.assume.alignment %completion_counter_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%bounded_token_count]x[%hidden_size]xf32, #dense>
  %weight_view = buffer.view %weight_noalias[%zero_offset] : buffer -> view<[%expert_count]x[%hidden_size]xf32, #dense>
  %logits_view = buffer.view %logits_noalias[%zero_offset] : buffer -> view<[%bounded_token_count]x[%expert_count]xf32, #dense>
  %completion_counter_view = buffer.view %completion_counter_aligned[%zero_offset] : buffer -> view<1xi32, #dense>
  %zero_f32x4 = vector.splat %zero_f32 : vector<4xf32>
  %vector_channel_end = index.sub %hidden_size, %three : index
  %lane_sums = scf.for %channel = [%lane_channel to %vector_channel_end step %onetwentyeight](%accumulators = %zero_f32x4 : vector<4xf32>) -> (vector<4xf32>) unroll(%four) schedule(interleaved) {
    %vector_channel = index.assume %channel [lt(%channel, %vector_channel_end)] : index
    %input_values = vector.load %input_view[%token, %vector_channel] : view<[%bounded_token_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %weight_values0 = vector.load %weight_view[%expert_base, %vector_channel] : view<[%expert_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %weight_values1 = vector.load %weight_view[%expert1, %vector_channel] : view<[%expert_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %weight_values2 = vector.load %weight_view[%expert2, %vector_channel] : view<[%expert_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %weight_values3 = vector.load %weight_view[%expert3, %vector_channel] : view<[%expert_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %accumulator0 = vector.extract %accumulators[0] : vector<4xf32> -> f32
    %accumulator1 = vector.extract %accumulators[1] : vector<4xf32> -> f32
    %accumulator2 = vector.extract %accumulators[2] : vector<4xf32> -> f32
    %accumulator3 = vector.extract %accumulators[3] : vector<4xf32> -> f32
    %next0 = vector.dotf %input_values, %weight_values0, %accumulator0 : vector<4xf32>, vector<4xf32>, f32
    %next1 = vector.dotf %input_values, %weight_values1, %accumulator1 : vector<4xf32>, vector<4xf32>, f32
    %next2 = vector.dotf %input_values, %weight_values2, %accumulator2 : vector<4xf32>, vector<4xf32>, f32
    %next3 = vector.dotf %input_values, %weight_values3, %accumulator3 : vector<4xf32>, vector<4xf32>, f32
    %next_accumulators = vector.from_elements %next0, %next1, %next2, %next3 : vector<4xf32>
    scf.yield %next_accumulators : vector<4xf32>
  }
  %sums = kernel.subgroup.reduce<addf> %lane_sums : vector<4xf32>
  %lane_i32 = index.cast %lane : index to i32
  %writes_projection = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %writes_projection {
    vector.store %sums, %logits_view[%token, %expert_base] : vector<4xf32>, view<[%bounded_token_count]x[%expert_count]xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %local_old_counter = scf.if %writes_projection -> (i32) {
    %old_counter = view.atomic.rmw<addi> %one_i32, %completion_counter_view[%zero] {ordering = acq_rel, scope = device} : i32, view<1xi32, #dense> -> i32
    scf.yield %old_counter : i32
  } else {
    scf.yield %zero_i32 : i32
  }
  %old_counter = kernel.workgroup.reduce<addi> %local_old_counter : i32
  %expert_tile_count_i32 = index.cast %expert_tile_count : index to i32
  %last_expert_tile_i32 = scalar.subi %expert_tile_count_i32, %one_i32 : i32
  %negative_expert_tile_count_i32 = scalar.subi %zero_i32, %expert_tile_count_i32 : i32
  %old_counter_f32 = scalar.sitofp %old_counter : i32 to f32
  %last_expert_tile_f32 = scalar.sitofp %last_expert_tile_i32 : i32 to f32
  %is_last_projection = scalar.cmpf oeq, %old_counter_f32, %last_expert_tile_f32 : f32
  scf.if %is_last_projection {
    func.apply<qwen3_moe.router.top8.row>(%publishes_row, %token, %bounded_token_count, %bounded_route_id_stride, %logits_noalias, %route_ids_noalias, %route_weights_noalias) : (i1, index, index, index, buffer, buffer, buffer)
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.if %writes_projection {
      view.atomic.reduce<addi> %negative_expert_tile_count_i32, %completion_counter_view[%zero] {ordering = release, scope = device} : i32, view<1xi32, #dense>
    }
  }
  kernel.return
}

config.decl @qwen3_moe_model_hidden_size : %value: index where [range(%value, 128, 32768), mul(%value, 256)]

config.decl @qwen3_moe_router_expert_count : %value: index where [range(%value, 32, 512), mul(%value, 32)]

config.decl @qwen3_moe_router_route_count : %value: index where [range(%value, 1, 32)]

func.template<qwen3_moe.router.top8.row> device @qwen3_moe_router_top8_row_f32(%valid_token: i1, %token: index, %token_count: index, %route_id_stride: index, %logits: buffer, %route_ids: buffer, %route_weights: buffer) {
  %expert_count0 = config.get @qwen3_moe_router_expert_count : index
  %route_count0 = config.get @qwen3_moe_router_route_count : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_route_id_stride = index.assume %route_id_stride [range(%route_id_stride, 1, 512)] : index
  %expert_count, %route_count, %route_id_stride_safe = index.assume %expert_count0, %route_count0, %bounded_route_id_stride [range(%expert_count0, 32, 512), mul(%expert_count0, 32), range(%route_count0, 1, 32), le(%route_count0, %expert_count0), le(%route_count0, %bounded_route_id_stride)] : index, index, index
  %safe_token, %launch_token_count = index.assume %token, %bounded_token_count [lt(%token, %bounded_token_count)] : index, index
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %wave_size = index.constant 32 : index
  %negative_large = scalar.constant -3.4028234663852885e+38 : f32
  %largest_i32 = scalar.constant 2147483647 : i32
  %zero_offset = index.constant 0 : offset
  %experts_per_lane0 = index.div %expert_count, %wave_size : index
  %experts_per_lane = index.assume %experts_per_lane0 [range(%experts_per_lane0, 1, 16)] : index
  %lane_expert_base = index.mul %lane, %experts_per_lane : index
  %route_id_storage_count = index.mul %launch_token_count, %route_id_stride_safe : index
  %route_weight_storage_count = index.mul %launch_token_count, %route_count : index
  %logits_noalias, %route_ids_noalias, %route_weights_noalias = buffer.assume.noalias %logits, %route_ids, %route_weights : buffer, buffer, buffer
  %logits_view = buffer.view %logits_noalias[%zero_offset] : buffer -> view<[%launch_token_count]x[%expert_count]xf32, #dense>
  %route_ids_view = buffer.view %route_ids_noalias[%zero_offset] : buffer -> view<[%route_id_storage_count]xi32, #dense>
  %route_weights_view = buffer.view %route_weights_noalias[%zero_offset] : buffer -> view<[%route_weight_storage_count]xf32, #dense>
  %initial_logits = vector.load %logits_view[%safe_token, %lane_expert_base] : view<[%launch_token_count]x[%expert_count]xf32, #dense> -> vector<[%experts_per_lane]xf32>
  %remaining_final, %selected_logit = scf.for %route = [%zero to %route_count step %one](%remaining_logits = %initial_logits : vector<[%experts_per_lane]xf32>, %lane_selected_logit = %negative_large : f32) -> (vector<[%experts_per_lane]xf32>, f32) {
    %local_value, %local_id = scf.for %slot = [%zero to %experts_per_lane step %one](%best_value = %negative_large : f32, %best_id = %largest_i32 : i32) -> (f32, i32) unroll {
      %candidate_value = vector.extract %remaining_logits[%slot] : vector<[%experts_per_lane]xf32> -> f32
      %candidate_expert = index.add %lane_expert_base, %slot : index
      %candidate_id = index.cast %candidate_expert : index to i32
      %is_greater = scalar.cmpf ogt, %candidate_value, %best_value : f32
      %is_equal = scalar.cmpf oeq, %candidate_value, %best_value : f32
      %is_lower_id = scalar.cmpi ult, %candidate_id, %best_id : i32
      %is_lower_tie = scalar.andi %is_equal, %is_lower_id : i1
      %is_better = scalar.ori %is_greater, %is_lower_tie : i1
      %next_value, %next_id = scf.if %is_better -> (f32, i32) {
        scf.yield %candidate_value, %candidate_id : f32, i32
      } else {
        scf.yield %best_value, %best_id : f32, i32
      }
      scf.yield %next_value, %next_id : f32, i32
    }
    %winner_value = kernel.subgroup.reduce<maxnumf> %local_value : f32
    %matches_winner = scalar.cmpf oeq, %local_value, %winner_value : f32
    %winner_lane_mask = kernel.subgroup.vote.ballot %matches_winner : i1 -> i64
    %nonzero_winner_lane_mask = scalar.assume %winner_lane_mask [ne(%winner_lane_mask, 0)] : i64
    %winner_lane_i64 = scalar.cttzi %nonzero_winner_lane_mask : i64
    %winner_lane0 = index.cast %winner_lane_i64 : i64 to index
    %winner_lane = index.assume %winner_lane0 [range(%winner_lane0, 0, 31)] : index
    %local_expert0 = index.cast %local_id : i32 to index
    %local_expert = index.assume %local_expert0 [range(%local_expert0, 0, 511)] : index
    %winner_slot = index.rem %local_expert, %experts_per_lane : index
    %owns_winner = index.cmp eq, %lane, %winner_lane : index
    %next_remaining_logits = scf.if %owns_winner -> (vector<[%experts_per_lane]xf32>) {
      %removed = vector.insert %negative_large into %remaining_logits[%winner_slot] : f32, vector<[%experts_per_lane]xf32>
      scf.yield %removed : vector<[%experts_per_lane]xf32>
    } else {
      scf.yield %remaining_logits : vector<[%experts_per_lane]xf32>
    }
    %publishes_route_id = scalar.andi %valid_token, %owns_winner : i1
    scf.if %publishes_route_id {
      %route_id_token_base = index.mul %safe_token, %route_id_stride_safe : index
      %route_id_index0 = index.add %route_id_token_base, %route : index
      %route_id_index = index.assume %route_id_index0 [lt(%route_id_index0, %route_id_storage_count)] : index
      view.store %local_id, %route_ids_view[%route_id_index] : i32, view<[%route_id_storage_count]xi32, #dense>
    }
    %lane_publishes_route = index.cmp eq, %lane, %route : index
    %publishes_route = scalar.andi %valid_token, %lane_publishes_route : i1
    %next_lane_selected_logit = scf.if %publishes_route -> (f32) {
      scf.yield %winner_value : f32
    } else {
      scf.yield %lane_selected_logit : f32
    }
    scf.yield %next_remaining_logits, %next_lane_selected_logit : vector<[%experts_per_lane]xf32>, f32
  }
  %selected_max = kernel.subgroup.reduce<maxnumf> %selected_logit : f32
  %selected_delta = scalar.subf<reassoc|nnan|ninf|nsz> %selected_logit, %selected_max : f32
  %unnormalized_weight = scalar.expf<afn> %selected_delta : f32
  %selected_sum = kernel.subgroup.reduce<addf> %unnormalized_weight : f32
  %route_weight = scalar.divf<reassoc|nnan|ninf|nsz|afn> %unnormalized_weight, %selected_sum : f32
  %lane_publishes_weight = index.cmp ult, %lane, %route_count : index
  %publishes_weight = scalar.andi %valid_token, %lane_publishes_weight : i1
  scf.if %publishes_weight {
    %route_weight_token_base = index.mul %safe_token, %route_count : index
    %route_weight_index = index.add %route_weight_token_base, %lane : index
    view.store %route_weight, %route_weights_view[%route_weight_index] : f32, view<[%route_weight_storage_count]xf32, #dense>
  }
  func.return
}
