// Shared Q4_K x Q8_1 row helper used by Qwen3 MoE fused projections.

func.def inline @qwen3_moe_q4k_chunk_global(%weight: buffer, %row_byte_base: offset, %q4_block: index, %q4_group: index, %q4_half: index) -> (vector<16xi8>, f32, f32) {
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %block_bytes = index.constant 144 : offset
  %scale_byte_add = index.constant 4 : offset
  %code_byte_add = index.constant 16 : offset
  %four_i32 = scalar.constant 4 : i32
  %six_i32 = scalar.constant 6 : i32
  %fifteen_i32 = scalar.constant 15 : i32
  %sixtythree_i32 = scalar.constant 63 : i32
  %nibble_mask = vector.constant 252645135 : vector<4xi32>
  %bounded_group = index.assume %q4_group [range(%q4_group, 0, 7)] : index
  %bounded_half = index.assume %q4_half [range(%q4_half, 0, 1)] : index
  %block_byte_add = index.scale %q4_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %scale_byte_base = index.add %block_byte_base, %scale_byte_add : offset
  %code_byte_base = index.add %block_byte_base, %code_byte_add : offset
  %half_view = buffer.view %weight[%block_byte_base] : buffer -> view<2xf16, #dense>
  %scale_view = buffer.view %weight[%scale_byte_base] : buffer -> view<12xi8, #dense>
  %code_view = buffer.view %weight[%code_byte_base] : buffer -> view<32xi32, #dense>
  %d_f16 = view.load %half_view[0] : view<2xf16, #dense> -> f16
  %dmin_f16 = view.load %half_view[1] : view<2xf16, #dense> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %dmin = scalar.extf %dmin_f16 : f16 to f32
  %iqs_group = index.mul %bounded_group, %eight : index
  %iqs_half = index.mul %bounded_half, %four : index
  %iqs = index.add %iqs_group, %iqs_half : index
  %qs_page0 = index.div %iqs, %sixteen : index
  %qs_page = index.mul %qs_page0, %eight : index
  %qs_lane = index.rem %iqs, %eight : index
  %qs_index0 = index.add %qs_page, %qs_lane : index
  %qs_index = index.assume %qs_index0 [range(%qs_index0, 0, 28)] : index
  %iqs_mod16 = index.rem %iqs, %sixteen : index
  %nibble_page = index.div %iqs_mod16, %eight : index
  %nibble_shift_index = index.mul %nibble_page, %four : index
  %nibble_shift_i32 = index.cast %nibble_shift_index : index to i32
  %nibble_shift = vector.splat %nibble_shift_i32 : vector<4xi32>
  %packed_codes = vector.load %code_view[%qs_index] : view<32xi32, #dense> -> vector<4xi32>
  %shifted_codes = vector.shrui %packed_codes, %nibble_shift : vector<4xi32>
  %masked_codes = vector.andi %shifted_codes, %nibble_mask : vector<4xi32>
  %q4_values = vector.bitcast %masked_codes : vector<4xi32> to vector<16xi8>
  %is_low_group = index.cmp ult, %bounded_group, %four : index
  %scale, %minimum = scf.if %is_low_group -> (i32, i32) {
    %minimum_index = index.add %bounded_group, %four : index
    %scale_i8 = view.load %scale_view[%bounded_group] : view<12xi8, #dense> -> i8
    %minimum_i8 = view.load %scale_view[%minimum_index] : view<12xi8, #dense> -> i8
    %scale_u8 = scalar.extui %scale_i8 : i8 to i32
    %minimum_u8 = scalar.extui %minimum_i8 : i8 to i32
    %scale_low6 = scalar.andi %scale_u8, %sixtythree_i32 : i32
    %minimum_low6 = scalar.andi %minimum_u8, %sixtythree_i32 : i32
    scf.yield %scale_low6, %minimum_low6 : i32, i32
  } else {
    %packed_index = index.add %bounded_group, %four : index
    %scale_high_index = index.sub %bounded_group, %four : index
    %packed_i8 = view.load %scale_view[%packed_index] : view<12xi8, #dense> -> i8
    %scale_high_i8 = view.load %scale_view[%scale_high_index] : view<12xi8, #dense> -> i8
    %minimum_high_i8 = view.load %scale_view[%bounded_group] : view<12xi8, #dense> -> i8
    %packed = scalar.extui %packed_i8 : i8 to i32
    %scale_high = scalar.extui %scale_high_i8 : i8 to i32
    %minimum_high = scalar.extui %minimum_high_i8 : i8 to i32
    %scale_low4 = scalar.andi %packed, %fifteen_i32 : i32
    %minimum_low4 = scalar.shrui %packed, %four_i32 : i32
    %scale_high2_raw = scalar.shrui %scale_high, %six_i32 : i32
    %minimum_high2_raw = scalar.shrui %minimum_high, %six_i32 : i32
    %scale_high2 = scalar.shli %scale_high2_raw, %four_i32 : i32
    %minimum_high2 = scalar.shli %minimum_high2_raw, %four_i32 : i32
    %scale_value = scalar.ori %scale_low4, %scale_high2 : i32
    %minimum_value = scalar.ori %minimum_low4, %minimum_high2 : i32
    scf.yield %scale_value, %minimum_value : i32, i32
  }
  %scale_f32 = scalar.uitofp %scale : i32 to f32
  %minimum_f32 = scalar.uitofp %minimum : i32 to f32
  %d_scale = scalar.mulf %d, %scale_f32 : f32
  %dmin_scale = scalar.mulf %dmin, %minimum_f32 : f32
  func.return %q4_values, %d_scale, %dmin_scale : vector<16xi8>, f32, f32
}

func.def inline @qwen3_moe_q4k_q8_1_dot(%q4_values: vector<16xi8>, %d_scale: f32, %dmin_scale: f32, %q8_values: vector<16xi8>, %q8_d: f32, %q8_s: f32) -> (f32) {
  %zero_i32 = scalar.constant 0 : i32
  %zero_i32v = vector.constant 0 : vector<4xi32>
  %half_f32 = scalar.constant 0.5 : f32
  %partial_dots = vector.dot4i<u8s8> %q4_values, %q8_values, %zero_i32v : vector<16xi8>, vector<16xi8>, vector<4xi32>
  %q_sum = vector.reduce<addi> %partial_dots, %zero_i32 : vector<4xi32>, i32
  %q_sum_f32 = scalar.sitofp %q_sum : i32 to f32
  %scaled_dot0 = scalar.mulf %q8_d, %d_scale : f32
  %scaled_dot = scalar.mulf %scaled_dot0, %q_sum_f32 : f32
  %q8_half_sum = scalar.mulf %q8_s, %half_f32 : f32
  %minimum_correction = scalar.mulf %dmin_scale, %q8_half_sum : f32
  %contribution = scalar.subf %scaled_dot, %minimum_correction : f32
  func.return %contribution : f32
}

func.def inline @qwen3_moe_q4k_q8_1_chunk(%weight: buffer, %row_byte_base: offset, %q4_block: index, %q4_group: index, %q4_half: index, %q8_values: vector<16xi8>, %q8_d: f32, %q8_s: f32) -> (f32) {
  %q4_values, %d_scale, %dmin_scale = func.call @qwen3_moe_q4k_chunk_global(%weight, %row_byte_base, %q4_block, %q4_group, %q4_half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
  %contribution = func.call @qwen3_moe_q4k_q8_1_dot(%q4_values, %d_scale, %dmin_scale, %q8_values, %q8_d, %q8_s) : (vector<16xi8>, f32, f32, vector<16xi8>, f32, f32) -> (f32)
  func.return %contribution : f32
}

func.def inline @qwen3_moe_q4k_q8_1_x4_row_lane(%input_size: index, %weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row_byte_base: offset, %lane: index) -> (f32) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 32768), mul(%input_size, 256)] : index
  %bounded_lane = index.assume %lane [range(%lane, 0, 31)] : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %onetwentyeight = index.constant 128 : index
  %onehundredfortyfour = index.constant 144 : index
  %twofiftysix = index.constant 256 : index
  %fivehundredeleven = index.constant 511 : index
  %fiveonetwo = index.constant 512 : index
  %q8_group_bytes = index.constant 144 : offset
  %q8_payload_byte_add = index.constant 16 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %q4_block_count = index.div %bounded_input_size, %twofiftysix : index
  %q8_group_count = index.div %bounded_input_size, %onetwentyeight : index
  %padded_input_size = index.add %bounded_input_size, %fivehundredeleven : index
  %iteration_count = index.div %padded_input_size, %fiveonetwo : index
  %q4_group0 = index.div %bounded_lane, %two : index
  %q4_group1 = index.rem %q4_group0, %eight : index
  %q4_group = index.assume %q4_group1 [range(%q4_group1, 0, 7)] : index
  %q4_half0 = index.rem %bounded_lane, %two : index
  %q4_half = index.assume %q4_half0 [range(%q4_half0, 0, 1)] : index
  %lane_q4_block = index.div %bounded_lane, %sixteen : index
  %lane_q8_group = index.div %bounded_lane, %eight : index
  %q8_inner_block0 = index.div %bounded_lane, %two : index
  %q8_inner_block1 = index.rem %q8_inner_block0, %four : index
  %q8_inner_block = index.assume %q8_inner_block1 [range(%q8_inner_block1, 0, 3)] : index
  %q8_inner_word_base = index.mul %q8_inner_block, %eight : index
  %q8_half_word_add = index.mul %q4_half, %four : index
  %q8_word_index0 = index.add %q8_inner_word_base, %q8_half_word_add : index
  %q8_word_index = index.assume %q8_word_index0 [range(%q8_word_index0, 0, 28)] : index
  %q8_ds_index = index.mul %q8_inner_block, %two : index
  %q8_s_index = index.add %q8_ds_index, %one : index
  %sum = scf.for %iteration = [%zero to %iteration_count step %one](%iteration_acc = %zero_f32 : f32) -> (f32) unroll {
    %iteration_q4_block = index.mul %iteration, %two : index
    %q4_block0 = index.add %iteration_q4_block, %lane_q4_block : index
    %valid_q4_block = index.cmp ult, %q4_block0, %q4_block_count : index
    %contribution = scf.if %valid_q4_block -> (f32) {
      %q4_block, %bounded_q4_block_count = index.assume %q4_block0, %q4_block_count [lt(%q4_block0, %q4_block_count)] : index, index
      %iteration_q8_group = index.mul %iteration, %four : index
      %q8_group0 = index.add %iteration_q8_group, %lane_q8_group : index
      %q8_group, %bounded_q8_group_count = index.assume %q8_group0, %q8_group_count [lt(%q8_group0, %q8_group_count)] : index, index
      %q8_group_byte_add = index.scale %q8_group, %q8_group_bytes : index, offset -> offset
      %q8_group_byte_base = index.add %q8_row_byte_base, %q8_group_byte_add : offset
      %q8_payload_byte_base = index.add %q8_group_byte_base, %q8_payload_byte_add : offset
      %q8_ds_view = buffer.view %q8_input[%q8_group_byte_base] : buffer -> view<8xf16, #dense>
      %q8_words_view = buffer.view %q8_input[%q8_payload_byte_base] : buffer -> view<32xi32, #dense>
      %q8_d_f16 = view.load %q8_ds_view[%q8_ds_index] : view<8xf16, #dense> -> f16
      %q8_s_f16 = view.load %q8_ds_view[%q8_s_index] : view<8xf16, #dense> -> f16
      %q8_d = scalar.extf %q8_d_f16 : f16 to f32
      %q8_s = scalar.extf %q8_s_f16 : f16 to f32
      %q8_words = vector.load %q8_words_view[%q8_word_index] : view<32xi32, #dense> -> vector<4xi32>
      %q8_values = vector.bitcast %q8_words : vector<4xi32> to vector<16xi8>
      %dot = func.call @qwen3_moe_q4k_q8_1_chunk(%weight, %weight_row_byte_base, %q4_block, %q4_group, %q4_half, %q8_values, %q8_d, %q8_s) : (buffer, offset, index, index, index, vector<16xi8>, f32, f32) -> (f32)
      scf.yield %dot : f32
    } else {
      scf.yield %zero_f32 : f32
    }
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %iteration_acc, %contribution : f32
    scf.yield %next : f32
  }
  func.return %sum : f32
}
