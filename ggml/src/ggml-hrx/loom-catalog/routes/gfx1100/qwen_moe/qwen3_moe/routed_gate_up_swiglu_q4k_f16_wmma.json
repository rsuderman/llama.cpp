{
  "schema": "ggml-hrx-loom-fusion-route-v2",
  "id": "qwen3_moe_routed_gate_up_swiglu_q4k_f16_wmma",
  "format": "loom",
  "priority": 260,
  "tensors": {
    "gate_weight": {"type": "Q4_K", "shape": ["input_size", "output_size", "expert_count", 1], "layout": "contiguous"},
    "input": {"type": "F32", "shape": ["input_size", 1, "token_count", 1], "layout": "contiguous"},
    "route_ids": {"type": "I32", "shape": ["route_count", "token_count", 1, 1]},
    "gate_projection": {"type": "F32", "shape": ["output_size", "route_count", "token_count", 1], "layout": "contiguous"},
    "up_weight": {"type": "Q4_K", "shape": ["input_size", "output_size", "expert_count", 1], "layout": "contiguous"},
    "up_projection": {"type": "F32", "shape": ["output_size", "route_count", "token_count", 1], "layout": "contiguous"},
    "output": {"type": "F32", "shape": ["output_size", "route_count", "token_count", 1], "layout": "contiguous"}
  },
  "match": {
    "anchors": ["gate"],
    "ops": {
      "gate": {
        "op": "GGML_OP_MUL_MAT_ID",
        "tensors": {
          "src0": "gate_weight",
          "src1": "input",
          "src2": "route_ids",
          "dst": "gate_projection"
        },
        "attributes": {}
      },
      "up": {
        "op": "GGML_OP_MUL_MAT_ID",
        "tensors": {
          "src0": "up_weight",
          "src1": "input",
          "src2": "route_ids",
          "dst": "up_projection"
        },
        "attributes": {}
      },
      "swiglu": {
        "op": "GGML_OP_GLU",
        "tensors": {
          "src0": "gate_projection",
          "src1": "up_projection",
          "dst": "output"
        },
        "attributes": {
          "glu_op": {
            "type": "i32",
            "source": "op_param.0"
          }
        }
      }
    },
    "predicates": [
      {"field": "attribute.swiglu.glu_op", "equals": 2},
      {"field": "shape.gate_weight.input_size", "equals": 2048},
      {"field": "shape.output.output_size", "equals": 768},
      {"field": "shape.output.route_count", "equals": 8},
      {"field": "shape.gate_weight.expert_count", "equals": 128},
      {"field": "shape.output.token_count", "min": 1},
      {"field": "shape.output.token_count", "max": 2048},
      {"field": "tensor.route_ids.element_strides.1", "min": 8},
      {"field": "tensor.route_ids.element_strides.1", "max": 128},
      {"elided": ["gate_projection", "up_projection"]},
      {"no_overlap": ["input", "output"]},
      {"no_overlap": ["gate_weight", "output"]},
      {"no_overlap": ["up_weight", "output"]}
    ]
  },
  "derived": {
    "token_count": {"type": "i64", "field": "shape.output.token_count"},
    "route_count": {"type": "i64", "field": "shape.output.route_count"},
    "route_stride": {"type": "i64", "field": "tensor.route_ids.element_strides.1"},
    "expert_count": {"type": "i64", "field": "shape.gate_weight.expert_count"},
    "token_plus_one": {"type": "i64", "sum": ["derived.token_count", 1]},
    "expert_table_i32_count": {"type": "i64", "product": ["derived.expert_count", "derived.token_plus_one"]},
    "expert_table_bytes": {"type": "i64", "product": ["derived.expert_table_i32_count", 4]},
    "assignment_count": {"type": "i64", "product": ["derived.token_count", "derived.route_count"]},
    "assignment_partition_count": {"type": "i64", "ceil_div": ["derived.assignment_count", 32]},
    "partition_descriptor_count": {"type": "i64", "sum": ["derived.assignment_partition_count", "derived.expert_count"]},
    "partition_table_i32_count": {"type": "i64", "sum": [1, "derived.partition_descriptor_count"]},
    "partition_table_bytes": {"type": "i64", "product": ["derived.partition_table_i32_count", 4]},
    "output_tiles": {"type": "i64", "ceil_div": ["shape.output.output_size", 64]},
    "launch_partition_count": {"type": "i64", "maximum": ["derived.assignment_partition_count", "derived.expert_count"]}
  },
  "transient_buffers": {
    "expert_table": {"size": "derived.expert_table_bytes"},
    "partition_table": {"size": "derived.partition_table_bytes"}
  },
  "architectures": ["gfx1100"],
  "dispatches": [
    {
