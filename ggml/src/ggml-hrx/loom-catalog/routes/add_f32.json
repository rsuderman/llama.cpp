{
  "schema": "ggml-hrx-loom-route-v1",
  "id": "add_f32_contiguous",
  "architectures": [
    "*"
  ],
  "definition": "../defs/add_f32.json",
  "format": "loom",
  "priority": 100,
  "match": {
    "op": "GGML_OP_ADD",
    "tensors": {
      "src0": {
        "type": "F32"
      },
      "src1": {
        "type": "F32"
      },
      "dst": {
        "type": "F32",
        "shape": [
          "ne0",
          "ne1",
          "ne2",
          "ne3"
        ]
      }
    },
    "predicates": [
      {
        "contiguous": "src0"
      },
      {
        "contiguous": "src1"
      },
      {
        "contiguous": "dst"
      },
      {
        "same_shape": [
          "src0",
          "src1"
        ]
      },
      {
        "same_shape": [
          "src0",
          "dst"
        ]
      }
    ]
  },
  "derived": {
    "nelements": {
      "type": "i64",
      "product": [
        "shape.dst.ne0",
        "shape.dst.ne1",
        "shape.dst.ne2",
        "shape.dst.ne3"
      ]
    }
  },
  "config": {
    "mode": "compile",
    "bindings": [
      {
        "name": "nelements",
        "source": "derived.nelements",
        "type": "i64"
      },
      {
        "name": "workgroup_size_x",
        "value": 256,
        "type": "i64"
      }
    ]
  },
  "invocation": {
    "buffers": [
      {
        "name": "src0",
        "tensor": "src0",
        "position": 0,
        "kind": "input"
      },
      {
        "name": "src1",
        "tensor": "src1",
        "position": 1,
        "kind": "input"
      },
      {
        "name": "dst",
        "tensor": "dst",
        "position": 2,
        "kind": "output"
      }
    ],
    "scalars": [
      {
        "name": "nelements",
        "source": "derived.nelements",
        "type": "i64",
        "position": 0
      }
    ],
    "dispatch": {
      "work_items": [
        "derived.nelements"
      ],
      "workgroup_size": [
        256,
        1,
        1
      ]
    }
  }
}
