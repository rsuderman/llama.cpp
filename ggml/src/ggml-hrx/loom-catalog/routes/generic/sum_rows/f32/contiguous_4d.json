{
  "schema": "ggml-hrx-loom-route-v1",
  "id": "sum_rows_f32_contiguous_4d",
  "format": "loom",
  "priority": 100,
  "match": {
    "op": "GGML_OP_SUM_ROWS",
    "tensors": {
      "src0": {"type": "F32", "shape": ["d0", "d1", "d2", "d3"]},
      "dst": {"type": "F32", "shape": ["d0", "d1", "d2", "d3"]}
    },
    "attributes": {},
    "predicates": [
      {"field": "derived.total_size", "min": 1},
      {"field": "derived.total_size", "max": 1073741824},
      {"field": "shape.dst.d0", "equals": 1},
      {"contiguous": "src0"},
      {"contiguous": "dst"},
      {"field": "shape.src0.d1", "equals": "shape.dst.d1"},
      {"field": "shape.src0.d2", "equals": "shape.dst.d2"},
      {"field": "shape.src0.d3", "equals": "shape.dst.d3"},
      {"field": "derived.flattened_trailing_dimensions", "equals": "derived.dst_total_size"}
    ]
  },
  "derived": {
    "flattened_trailing_dimensions": {
      "type": "i64",
      "product": ["shape.src0.d1", "shape.src0.d2", "shape.src0.d3"]
    },
    "dst_total_size": {
      "type": "i64",
      "product": ["shape.dst.d0", "shape.dst.d1", "shape.dst.d2", "shape.dst.d3"]
    },
    "total_size": {
      "type": "i64",
      "product": ["shape.src0.d0", "shape.src0.d1", "shape.src0.d2", "shape.src0.d3"]
    }
  },
  "architectures": ["*"],
  "dispatches": [
    {
      "definition": "../../../../defs/generic/sum_rows/f32/contiguous_4d.json",
      "config": {
        "mode": "compile",
        "bindings": [
          {
            "name": "shape_sum_rows_ncols",
            "type": "i64",
            "source": "shape.src0.d0"
          },
          {
            "name": "shape_sum_rows_nrows",
            "type": "i64",
            "source": "derived.flattened_trailing_dimensions"
          },
          {
            "name": "shape_sum_rows_src0_row_stride",
            "type": "i64",
            "source": "shape.src0.d0"
          },
          {
            "name": "tuning_sum_rows_workgroup_size",
            "type": "i64",
            "value": 32
          }
        ]
      },
      "buffers": [
        {
          "name": "src0",
          "tensor": "src0",
          "position": 0,
          "kind": "input"
        },
        {
          "name": "dst",
          "tensor": "dst",
          "position": 1,
          "kind": "output"
        }
      ],
      "scalars": [],
      "dispatch": {
        "workgroup_size": [32, 1, 1],
        "workgroups": ["derived.flattened_trailing_dimensions"]
      }
    }
  ]
