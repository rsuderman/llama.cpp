{
  "schema": "ggml-hrx-loom-route-v1",
  "id": "get_rows_f32_contiguous_rows_4d",
  "format": "loom",
  "priority": 100,
  "match": {
    "op": "GGML_OP_GET_ROWS",
    "tensors": {
      "src0": {"type": "F32", "shape": ["d0", "d1", "d2", "d3"]},
      "src1": {"type": "I32", "shape": ["d0", "d1", "d2", "d3"]},
      "dst": {"type": "F32", "shape": ["d0", "d1", "d2", "d3"]}
    },
    "attributes": {},
    "predicates": [
      {"field": "derived.total_size", "min": 1},
      {"field": "derived.total_size", "max": 1073741824},
      {"field": "shape.src0.d2", "equals": 1},
      {"field": "shape.src0.d3", "equals": 1},
      {"field": "shape.src1.d1", "equals": 1},
      {"field": "shape.src1.d2", "equals": 1},
      {"field": "shape.src1.d3", "equals": 1},
      {"field": "shape.dst.d2", "equals": 1},
      {"field": "shape.dst.d3", "equals": 1},
      {"field": "shape.src0.d0", "equals": "shape.dst.d0"},
      {"field": "shape.src1.d0", "equals": "shape.dst.d1"},
      {"contiguous": "src0"},
      {"contiguous": "src1"},
      {"contiguous": "dst"}
    ]
  },
  "derived": {
    "total_size": {
      "type": "i64",
      "product": ["shape.dst.d0", "shape.dst.d1", "shape.dst.d2", "shape.dst.d3"]
    }
  },
  "architectures": ["*"],
  "dispatches": [
    {
      "definition": "../../../../defs/generic/get_rows/f32/contiguous_rows_4d.json",
      "config": {
        "mode": "compile",
        "bindings": [
          {
            "name": "shape_get_rows_ncols",
            "type": "i64",
            "source": "shape.dst.d0"
          },
          {
            "name": "shape_get_rows_nrows",
            "type": "i64",
            "source": "shape.dst.d1"
          },
          {
            "name": "shape_get_rows_src0_nrows",
            "type": "i64",
            "source": "shape.src0.d1"
          },
          {
            "name": "shape_get_rows_idx_row_stride",
            "type": "i64",
            "source": "tensor.src1.element_strides.0"
          },
          {
            "name": "tuning_get_rows_workgroup_size",
            "type": "i64",
            "value": 256
          }
        ]
      },
      "buffers": [
        {
          "name": "src0",
          "tensor": "src0",
          "position": 0,
          "kind": "input"
        },
        {
          "name": "idx",
          "tensor": "src1",
          "position": 1,
          "kind": "input"
        },
        {
          "name": "dst",
          "tensor": "dst",
          "position": 2,
          "kind": "output"
        }
      ],
      "scalars": [],
      "dispatch": {
        "work_items": ["derived.total_size"],
        "workgroup_size": [256, 1, 1]
      }
    }
  ]
}
