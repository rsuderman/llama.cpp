{
  "schema": "ggml-hrx-loom-route-v1",
  "id": "soft_max_f32_contiguous_4d",
  "format": "loom",
  "priority": 101,
  "match": {
    "op": "GGML_OP_SOFT_MAX",
    "tensors": {
      "src0": {"type": "F32", "shape": ["d0", "d1", "d2", "d3"]},
      "dst": {"type": "F32", "shape": ["d0", "d1", "d2", "d3"]}
    },
    "attributes": {
      "max_bias": {"type": "f32"},
      "scale": {"type": "f32"}
    },
    "predicates": [
      {"field": "derived.total_size", "min": 1},
      {"field": "derived.total_size", "max": 1073741824},
      {"field": "derived.ncols", "min": 1},
      {"field": "derived.ncols", "max": 1024},
      {"field": "derived.nrows", "min": 1},
      {"field": "derived.nrows", "max": 1048576},
      {"src_absent": "src1"},
      {"src_absent": "src2"},
      {"field": "attribute.max_bias", "equals": 0.0},
      {"same_shape": ["src0", "dst"]},
      {"contiguous": "src0"},
      {"contiguous": "dst"}
    ]
  },
  "derived": {
    "total_size": {
      "type": "i64",
      "product": ["shape.dst.d0", "shape.dst.d1", "shape.dst.d2", "shape.dst.d3"]
    },
    "ncols": {
      "type": "i64",
      "product": ["shape.dst.d0"]
    },
    "nrows": {
      "type": "i64",
      "product": ["shape.dst.d1", "shape.dst.d2", "shape.dst.d3"]
    }
  },
  "architectures": ["*"],
  "dispatches": [
    {
      "definition": "../../../../defs/generic/soft_max/f32/contiguous_4d.json",
      "config": {
        "mode": "compile",
        "bindings": [
          {
            "name": "shape_soft_max_ncols",
            "type": "i64",
            "source": "derived.ncols"
          },
          {
            "name": "shape_soft_max_nrows",
            "type": "i64",
            "source": "derived.nrows"
          },
          {
            "name": "tuning_soft_max_workgroup_size",
            "type": "i64",
            "value": 1024
          }
        ]
      },
      "buffers": [
        {
          "name": "src0",
          "tensor": "src0",
          "position": 0,
          "kind": "input"
        },
        {
          "name": "dst",
          "tensor": "dst",
          "position": 1,
          "kind": "output"
        }
      ],
      "scalars": [
        {
          "name": "scale",
          "type": "f32",
          "position": 0,
          "source": "attribute.scale"
        }
      ],
      "dispatch": {
        "workgroup_size": [1024, 1, 1],
        "workgroups": ["derived.nrows"]
      }
    }
  ]
}
