  "config": {
    "mode": "compile",
    "bindings": [
      {"name": "shape_copy_n", "type": "i64", "source": "derived.total_size"},
      {"name": "tuning_copy_workgroup_size", "type": "i64", "value": 256}
    ]
  },
  "invocation": {
    "buffers": [
      {"name": "src0", "tensor": "src0", "position": 0, "kind": "input"},
      {"name": "dst", "tensor": "dst", "position": 1, "kind": "output"}
    ],
    "scalars": [],
    "dispatch": {
      "work_items": ["derived.total_size"],
      "workgroup_size": [256, 1, 1]
    }
  },
  "architectures": ["*"]
