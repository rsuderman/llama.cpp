  "format": "loom",
  "priority": 118,
  "match": {
    "op": "GGML_OP_CPY",
    "tensors": {
      "src0": {
        "type": "F16",
        "shape": ["d0", "d1", "d2", "d3"]
      },
      "dst": {
        "type": "F16",
        "shape": ["d0", "d1", "d2", "d3"]
      }
    },
    "attributes": {},
    "predicates": [
      {
        "same_shape": ["src0", "dst"]
      },
      {"contiguous": "src0"},
      {"contiguous": "dst"}
