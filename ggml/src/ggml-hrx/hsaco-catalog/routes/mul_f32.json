{
  "schema": "ggml-hrx-hsaco-route-v1",
  "id": "mul_f32_contiguous_row_broadcast_128x32",
  "definition": "../defs/mul_f32.json",
  "format": "amdgpu-hsaco",
  "priority": 100,
  "match": {
    "op": "GGML_OP_MUL",
    "tensors": {
      "src0": {"type": "F32", "shape": ["ncols", "nrows", "n2", "n3"]},
      "src1": {"type": "F32", "shape": ["ncols", "nrows", "n2", "n3"]},
      "dst": {"type": "F32", "shape": ["ne0", "ne1", "ne2", "ne3"]}
    },
    "predicates": [
      {"contiguous": "src0"},
      {"contiguous": "src1"},
      {"contiguous": "dst"},
      {"same_shape": ["src0", "dst"]},
      {"field": "shape.src0.ncols", "equals": 128},
      {"field": "shape.src0.nrows", "equals": 32},
      {"field": "shape.src0.n2", "equals": 1},
      {"field": "shape.src0.n3", "equals": 1},
      {"field": "shape.src1.ncols", "equals": 128},
      {"field": "shape.src1.nrows", "equals": 1},
      {"field": "shape.src1.n2", "equals": 1},
      {"field": "shape.src1.n3", "equals": 1}
    ]
  },
  "derived": {
    "nelements": {"type": "i64", "product": ["shape.dst.ne0", "shape.dst.ne1", "shape.dst.ne2", "shape.dst.ne3"]},
    "src1_nelements": {"type": "i64", "product": ["shape.src1.ncols", "shape.src1.nrows", "shape.src1.n2", "shape.src1.n3"]}
  },
  "invocation": {
    "buffers": [
      {"name": "src0", "tensor": "src0", "position": 0, "kind": "input"},
      {"name": "src1", "tensor": "src1", "position": 1, "kind": "input"},
      {"name": "dst", "tensor": "dst", "position": 2, "kind": "output"}
    ],
    "scalars": [
      {"name": "nelements", "source": "derived.nelements", "type": "i64", "position": 0},
      {"name": "ncols", "source": "shape.src0.ncols", "type": "i64", "position": 1},
      {"name": "src1_nelements", "source": "derived.src1_nelements", "type": "i64", "position": 2}
    ],
    "dispatch": {"kind": "flat_1d", "work_items": "derived.nelements", "workgroup_size": [256, 1, 1]}
  },
  "routing": {
    "op": "GGML_OP_MUL",
    "src0_type": "F32",
    "src1_type": "F32",
    "dst_type": "F32",
    "src0_layout": "contiguous",
    "src1_layout": "contiguous",
    "dst_layout": "contiguous",
    "shape": "src0_128x32_dst_same_src1_128x1"
  },
  "launch": {"threads_per_block": 256}
}
