{
  "schema": "ggml-hrx-hsaco-route-v1",
  "id": "sum_rows_f32_contiguous_ncols_8",
  "definition": "../defs/sum_rows_f32.json",
  "format": "amdgpu-hsaco",
  "priority": 100,
  "match": {
    "op": "GGML_OP_SUM_ROWS",
    "tensors": {
      "src0": {"type": "F32", "shape": ["ncols", "nrows_0", "nrows_1", "nrows_2"]},
      "dst": {"type": "F32", "shape": ["ncols", "nrows_0", "nrows_1", "nrows_2"]}
    },
    "predicates": [
      {"contiguous": "src0"},
      {"contiguous": "dst"},
      {"field": "shape.src0.ncols", "equals": 8},
      {"field": "shape.dst.ncols", "equals": 1},
      {"field": "shape.dst.nrows_0", "equals": "shape.src0.nrows_0"},
      {"field": "shape.dst.nrows_1", "equals": "shape.src0.nrows_1"},
      {"field": "shape.dst.nrows_2", "equals": "shape.src0.nrows_2"}
    ]
  },
  "derived": {
    "nrows": {"type": "i64", "product": ["shape.src0.nrows_0", "shape.src0.nrows_1", "shape.src0.nrows_2"]}
  },
  "invocation": {
    "buffers": [
      {"name": "src", "tensor": "src0", "position": 0, "kind": "input"},
      {"name": "dst", "tensor": "dst", "position": 1, "kind": "output"}
    ],
    "scalars": [
      {"name": "ncols", "source": "shape.src0.ncols", "type": "i64", "position": 0},
      {"name": "nrows", "source": "derived.nrows", "type": "i64", "position": 1}
    ],
    "dispatch": {"kind": "rows_1d", "rows": "derived.nrows", "workgroup_size": [256, 1, 1]}
  },
  "routing": {
    "op": "GGML_OP_SUM_ROWS",
    "src0_type": "F32",
    "dst_type": "F32",
    "src0_layout": "contiguous",
    "dst_layout": "contiguous",
    "shape": "ncols_8_sum_rows"
  },
  "launch": {"threads_per_block": 256}
}
