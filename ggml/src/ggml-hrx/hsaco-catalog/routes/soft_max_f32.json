{
  "schema": "ggml-hrx-hsaco-route-v1",
  "id": "soft_max_f32_contiguous_nomask_ncols_128",
  "definition": "../defs/soft_max_f32.json",
  "format": "amdgpu-hsaco",
  "priority": 100,
  "match": {
    "op": "GGML_OP_SOFT_MAX",
    "tensors": {
      "src0": {"type": "F32", "shape": ["ncols", "nrows_0", "nrows_1", "nrows_2"]},
      "dst": {"type": "F32"}
    },
    "attributes": {"scale": {"type": "f32", "default": 1.0}, "max_bias": {"type": "f32", "default": 0.0}},
    "predicates": [
      {"contiguous": "src0"},
      {"contiguous": "dst"},
      {"same_shape": ["src0", "dst"]},
      {"field": "shape.src0.ncols", "equals": 128},
      {"src_absent": "src1"},
      {"src_absent": "src2"},
      {"field": "attribute.scale", "equals": 1.0},
      {"field": "attribute.max_bias", "equals": 0.0}
    ]
  },
  "derived": {
    "nrows": {"type": "i64", "product": ["shape.src0.nrows_0", "shape.src0.nrows_1", "shape.src0.nrows_2"]}
  },
  "invocation": {
    "buffers": [
      {"name": "src", "tensor": "src0", "position": 0, "kind": "input"},
      {"name": "dst", "tensor": "dst", "position": 1, "kind": "output"}
    ],
    "scalars": [
      {"name": "ncols", "source": "shape.src0.ncols", "type": "i64", "position": 0},
      {"name": "nrows", "source": "derived.nrows", "type": "i64", "position": 1}
    ],
    "dispatch": {"workgroups": ["derived.nrows"], "workgroup_size": [256, 1, 1]}
  },
  "routing": {
    "op": "GGML_OP_SOFT_MAX",
    "src0_type": "F32",
    "dst_type": "F32",
    "src0_layout": "contiguous",
    "dst_layout": "contiguous",
    "shape": "same",
    "columns": 128,
    "mask": "none"
  }
}
