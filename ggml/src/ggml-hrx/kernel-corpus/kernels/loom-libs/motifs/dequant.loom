  %scales_l_view = buffer.view %weight[%scales_l_byte_base] : buffer -> view<1xi32>
  %code_view = buffer.view %weight[%code_byte_base] : buffer -> view<32xi32>
  %header = view.load %header_view[%c0] : view<1xi32> -> i32
  %header_vector = vector.from_elements %header : vector<1xi32>
  %header_halves = vector.bitcast %header_vector : vector<1xi32> to vector<2xf16>
  %d_f16 = vector.extract %header_halves[0] : vector<2xf16> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %scales_l = view.load %scales_l_view[%c0] : view<1xi32> -> i32
  %scales_h_shifted = scalar.shrui %header, %c16_i32 : i32
  %scales_h = scalar.andi %scales_h_shifted, %c65535_i32 : i32
