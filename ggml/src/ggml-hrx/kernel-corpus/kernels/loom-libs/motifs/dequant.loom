  %d_vector = vector.splat %d : vector<4xf32>
  %values = vector.mulf %codes_f32, %d_vector : vector<4xf32>
  func.return %values : vector<4xf32>
}

func.def inline @ggml_q8_1_f32_vector4(%weight: buffer, %row_byte_base: offset, %q8_block: index, %packet: index) -> (vector<4xf32>) {
