  %scale_l_shift = index.cast %scale_l_shift_index : index to i32
  %scale_l_shifted = scalar.shrui %scales_l, %scale_l_shift : i32
  %scale_l = scalar.andi %scale_l_shifted, %c15_i32 : i32
  %scale_h_shift_index = index.mul %bounded_group, %c2 : index
  %scale_h_shift = index.cast %scale_h_shift_index : index to i32
  %scale_h_shifted = scalar.shrui %scales_h, %scale_h_shift : i32
  %scale_h = scalar.andi %scale_h_shifted, %c3_i32 : i32
  %scale_h_high = scalar.shli %scale_h, %c4_i32 : i32
