  %qh_byte_base = index.add %block_byte_base, %qh_offset : offset
  %code_byte_base = index.add %block_byte_base, %code_offset : offset
  %d_view = buffer.view %weight[%block_byte_base] : buffer -> view<1xf16>
  %qh_view = buffer.view %weight[%qh_byte_base] : buffer -> view<1xi32>
  %code_view = buffer.view %weight[%code_byte_base] : buffer -> view<4xi32>
